{
    "name": "chenbool/etcd-buzz-client",
    "type": "library",
    "description": "PHP client for Etcd v3 using Buzz HTTP client",
    "keywords": ["etcdv3", "etcd", "etcd-client", "buzz", "v3"],
    "homepage": "https://github.com/chenbool/etcd-buzz-client",
    "license": "MIT",
    "authors": [
        {
            "name": "chenbool",
            "email": "your@email.com",
            "homepage": "https://github.com/chenbool"
        }
    ],
    "require": {
        "php": "^8.2",
        "kriswallsmith/buzz": "^1.3",
        "nyholm/psr7": "^1.8",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            "chenbool\\Etcd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "chenbool\\Etcd\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/chenbool"
        }
    ]
}
